# WhatsApp number that is allowed to interact with the bridge.
# Use international format WITHOUT a leading "+".
# Example: 4917612345678
ALLOWED_WHATSAPP_NUMBER=4917612345678

# OpenAssistant API endpoints.
OPENASSISTANT_URL=http://127.0.0.1:8080/api/chat/stream
OPENASSISTANT_UPLOAD_URL=http://127.0.0.1:8080/api/upload

# Optional authentication token for OpenAssistant.
# Leave empty if authentication is disabled.
OPENASSISTANT_TOKEN=

# Channel used for regular chat messages.
OPENASSISTANT_CHANNEL=whatsapp

# Channel used when sending uploaded images to OpenAssistant.
OPENASSISTANT_IMAGE_CHANNEL=webui

# Secret token used to authenticate requests to the bridge.
# Replace this placeholder with a strong, randomly generated secret.
BRIDGE_TOKEN=<random secret>

# Persistent storage for WhatsApp session/database data.
WHATSAPP_DB=./data/whatsapp.db

# File used to persist conversation state between restarts.
CONVERSATION_STATE_FILE=./data/conversation_state.json

# Command that clears the current conversation state.
CLEAR_COMMAND=/clear

# Temporary directory for uploaded images.
TEMP_IMAGE_DIR=./data/tmp

# Maximum allowed image upload size in megabytes.
MAX_IMAGE_MB=20

# Default prompt sent together with an uploaded image.
DEFAULT_IMAGE_PROMPT=What can be seen in this image?

# Network interface and port the bridge listens on.
HOST=127.0.0.1
PORT=8081

# Maximum time, in seconds, to wait for upstream requests.
REQUEST_TIMEOUT=180

# Application log level (e.g. DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# Ignore messages originating from WhatsApp groups.
IGNORE_GROUPS=true

# If false, outgoing messages are restricted to the allowed WhatsApp number.
ALLOW_SEND_TO_ANY=false

# OpenRouter API key used for image-related requests/uploads.
# Keep this value secret and never commit it to version control.
OPENROUTER_API_KEY=<secret>